# Managed by the Empathy Gallery native installer.
[Unit]
Description=Empathy Gallery HTTPS reverse proxy
Wants=network-online.target empathy-classroom.service
After=network-online.target empathy-classroom.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=notify
User=empathy-caddy
Group=empathy-caddy
EnvironmentFile=/etc/empathy-classroom/room.env
Environment=XDG_DATA_HOME=/var/lib/empathy-classroom-https/data
Environment=XDG_CONFIG_HOME=/var/lib/empathy-classroom-https/config
ExecStart=/opt/empathy-classroom/runtime/caddy-v2.11.8/caddy run --config /etc/empathy-classroom/Caddyfile --adapter caddyfile
ExecReload=/opt/empathy-classroom/runtime/caddy-v2.11.8/caddy reload --config /etc/empathy-classroom/Caddyfile --adapter caddyfile --address unix//run/empathy-classroom-https/admin.sock
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=empathy-classroom-https
StateDirectoryMode=0700
RuntimeDirectory=empathy-classroom-https
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LockPersonality=true
LimitNOFILE=16384
TasksMax=64
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
